{
  "name": "chainsightline",
  "version": "0.1.0",
  "description": "Follow the line: read Ethereum transactions one stop at a time, check an address before you pay it, and check your wallet for risky approvals.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sjdsjadjajdjsa/chainsightline.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "cli": "node bin/chainsightline.mjs",
    "trace": "node bin/chainsightline.mjs trace",
    "web": "node bin/chainsightline.mjs web",
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node design_system/tools/capture.mjs",
    "test:ai:live": "node --import tsx scripts/openrouter-smoke.ts",
    "test:chain:live": "node --import tsx scripts/drpc-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "viem": "2.57.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "bin": {
    "chainsightline": "bin/chainsightline.mjs"
  }
}
